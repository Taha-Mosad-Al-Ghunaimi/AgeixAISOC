# ═══════════════════════════════════════════════════════════════════════════════
# AgeixAISOC Backend — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy to .env and adjust values:
#   cp .env.example .env
#
# For Docker Compose deployment, these defaults connect to local containers.
# For standalone dev (no Docker), change hostnames to "localhost".
# ═══════════════════════════════════════════════════════════════════════════════

# ── LLM Provider ──────────────────────────────────────────────────────────
# Options: "ollama" (local GPU) | "groq" (cloud)
LLM_PROVIDER=ollama

# ── Ollama (local inference via Docker) ──────────────────────────────────
# Inside Docker:  http://ollama-llm:11434
# Local dev:      http://localhost:11434
OLLAMA_BASE_URL=http://ollama-llm:11434

# Master Brain model (14B params — ~9 GB VRAM)
OLLAMA_MODEL=qwen2.5:14b

# Coder Agent model (7B params — ~4.5 GB VRAM)
OLLAMA_CODER_MODEL=qwen2.5-coder:7b

# ── Groq (cloud fallback) ─────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_api_key_here
GROQ_MODEL=llama3-70b-8192

# ── OSINT ─────────────────────────────────────────────────────────────────
OTX_API_KEY=your_otx_api_key_here

# ── Redis Event Bus ───────────────────────────────────────────────────────
# Inside Docker:  redis://redis-bus:6379/0
# Local dev:      redis://localhost:6379/0
REDIS_URL=redis://redis-bus:6379/0

# ── PostgreSQL + pgvector (RAG memory, audit trail) ─────────────────────
# Inside Docker:  postgresql://ageixai:ageixai@postgres-db:5432/ageixai
# Local dev:      postgresql://ageixai:ageixai@localhost:5432/ageixai
DATABASE_URL=postgresql://ageixai:ageixai@postgres-db:5432/ageixai
AUDIT_DATABASE_URL=postgresql://ageixai:ageixai@postgres-db:5432/ageixai

# ── Vector Store ──────────────────────────────────────────────────────────
# Supported: mock | pgvector | chroma
VECTOR_STORE_PROVIDER=pgvector

# Embedding dimension (matches embedding model output)
PG_VECTOR_DIMENSION=1536

# ChromaDB fallback path (used only if VECTOR_STORE_PROVIDER=chroma)
CHROMA_PERSIST_DIR=./data/chroma

# ── n8n SOAR Webhook ─────────────────────────────────────────────────────
# Inside Docker:  http://n8n-soar:5678/webhook/ageixai-soar
# Local dev:      http://localhost:5678/webhook/ageixai-soar
N8N_WEBHOOK_URL=http://n8n-soar:5678/webhook/ageixai-soar

# ── Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
